{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/coding",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local LiteLLM",
      "options": {
        "baseURL": "http://localhost:4000/v1",
        "apiKey": "{env:LITELLM_MASTER_KEY}"
      },
      "models": {
        "coding": {
          "name": "Qwen2.5 Coder 7B via LiteLLM"
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:7b": {
          "name": "Qwen2.5 Coder 7B"
        }
      }
    }
  },
  "mcp": {
    "beans-cafe-research": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "--no-project",
        "--with",
        "mcp>=1.9,<2",
        "python",
        "-m",
        "apps.cafe_research.mcp_server"
      ],
      "cwd": ".",
      "environment": {
        "CAFE_RESEARCH_DB_PATH": "../BEANS/beans-cafe-ads/data/cafe-research.sqlite3",
        "CAFE_RESEARCH_PRODUCT_PROFILE": "../BEANS/beans-cafe-ads/memory/product-profile.json"
      },
      "enabled": true,
      "timeout": 30000
    }
  }
}
